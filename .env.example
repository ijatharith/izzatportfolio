# Public site URL — used for canonical URLs, sitemap and Open Graph.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (Resend — https://resend.com). The form shows a
# "not connected yet" notice until RESEND_API_KEY is set.
RESEND_API_KEY=
# Where messages are delivered. Defaults to the email in src/data/profile.ts.
CONTACT_TO_EMAIL=
# Verified sender. Defaults to Resend's test sender, which only delivers to
# the Resend account owner's address — verify your domain for production.
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"
